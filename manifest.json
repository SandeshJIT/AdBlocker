{
  "manifest_version": 3,
  "name": "Robust Ad Blocker",
  "version": "2.2",
  "permissions": ["scripting", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["adblocker.css"],
    "run_at": "document_start"
  }]
}
